{% set u = curso.uea %}
site_name: {{ (u.nombre ~ " " ~ u.clave) | yaml }}
site_description: {{ (u.nombre ~ " · " ~ u.plan ~ ((" · " ~ u.unidad_corta) if u.unidad_corta else "")) | yaml }}
site_author: {{ u.profesor | yaml }}
site_url: {{ u.sitio }}
repo_url: {{ u.repositorio }}
repo_name: {{ u.repositorio | replace("https://github.com/", "") | yaml }}
edit_uri: edit/main/docs/
{% if u.institucion %}
copyright: {{ (u.institucion ~ ((" · División de " ~ u.division) if u.division is defined and u.division else "")) | yaml }}
{% endif %}

theme:
  name: material
  language: es
  features:
    - navigation.instant
    - navigation.tracking
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - navigation.footer
    - toc.follow
    - search.suggest
    - search.highlight
    - content.action.edit
    - content.code.copy
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      toggle: {icon: material/weather-night, name: Cambiar a modo oscuro}
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      toggle: {icon: material/weather-sunny, name: Cambiar a modo claro}

plugins:
  - search:
      lang: es
  # Regenera el sitio a partir del programa analítico antes de cada construcción.
  - programa-sitio

markdown_extensions:
  - admonition
  - pymdownx.details
  - pymdownx.superfences
  - attr_list
  - md_in_html
  - tables
  - footnotes
  - toc:
      permalink: true
      toc_depth: 3

extra:
  social:
    - icon: fontawesome/solid/envelope
      link: mailto:{{ u.correo }}
      name: Correo del profesor
{% if u.telegram is defined %}
    - icon: fontawesome/brands/telegram
      link: https://t.me/{{ u.telegram }}
      name: Telegram
{% endif %}

nav:
{% for e in menu %}
{% if e.hijos is defined %}
  - {{ e.titulo | yaml }}:
{% for h in e.hijos %}
      - {{ h.titulo | yaml }}: {{ h.ruta }}
{% endfor %}
{% else %}
  - {{ e.titulo | yaml }}: {{ e.ruta }}
{% endif %}
{% endfor %}
