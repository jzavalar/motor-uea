#!/usr/bin/env bash
# Antes de cada commit, regenera el sitio a partir de la fuente y agrega al commit las
# páginas generadas que cambiaron (y quita las que ya no corresponden a nada). Si la
# fuente no es consistente, detiene el commit y dice por qué.
# Lo instala ./sitio.sh preparar (git config core.hooksPath .githooks).
set -euo pipefail
raiz="$(git rev-parse --show-toplevel)"
cd "$raiz"
motor="$raiz/.venv/bin/programa-sitio"
if [ ! -x "$motor" ]; then
    motor="$(command -v programa-sitio || true)"
fi
if [ -z "$motor" ]; then
    echo "pre-commit: falta programa-sitio; ejecute ./sitio.sh preparar" >&2
    echo "            (o, solo esta vez, git commit --no-verify)" >&2
    exit 1
fi
if ! cambios="$("$motor" construir --porcelana --curso "$raiz")"; then
    echo "pre-commit: la fuente no es consistente (ver arriba); no se hizo el commit." >&2
    exit 1
fi
if [ -n "$cambios" ]; then
    echo "pre-commit: se regeneraron y se agregaron al commit:"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        echo "  · $f"
        if [ -e "$f" ]; then
            git add -- "$f"
        else
            git rm --cached --quiet --ignore-unmatch -- "$f"
        fi
    done <<< "$cambios"
fi
